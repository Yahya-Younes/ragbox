# Copy to .env to customise ragbox (all optional).

# Port on your computer
RAGBOX_PORT=8080

# Models (any model from https://ollama.com/library)
RAGBOX_CHAT_MODEL=gemma3:4b
RAGBOX_EMBED_MODEL=nomic-embed-text

# Largest file you can upload, in MB
RAGBOX_MAX_UPLOAD_MB=50

# Use an Ollama already installed on your computer instead of the container (faster on Mac):
# RAGBOX_OLLAMA_URL=http://host.docker.internal:11434
